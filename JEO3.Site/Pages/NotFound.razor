@page "/not-found"
@using Microsoft.AspNetCore.Mvc
@attribute [IgnoreAntiforgeryToken]

<PageTitle>404 - Page Not Found</PageTitle>

<div class="not-found-container" style="text-align: center; padding: 3rem 1rem;">
    <h1 style="font-size: 5rem; color: #dc3545; margin: 0;">404</h1>
    <h2 style="margin-top: 0;">Oops! Page Not Found</h2>
    <p style="color: #6c757d;">The address you are looking for does not exist or has been moved.</p>
    <a href="/" style="display: inline-block; background-color: #0d6efd; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 0.25rem; margin-top: 1rem;">
        Back to Home
    </a>
</div>

