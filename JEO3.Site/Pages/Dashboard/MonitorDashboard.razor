@code
{

	#region Traffic Stress
	private async Task GenerateTraffic()
	{
		if (W.Observation.Traffic.IsRunning) { return; }
		W.Observation.Traffic.IsRunning = true;

		try
		{
			const int upLimit = 3;
			const int downLimit = 3;
			int idx = 0;
			Parallel.ForEach(W.Context.Tables, new ParallelOptions() { MaxDegreeOfParallelism = 2 }, async (tbl) =>
			{
				idx++;
				int pctCompleted = (int)(((double)(idx) / (double)(W.Context.Tables.Count)) * 100);
				W.Observation.Traffic.CurrentTable = tbl.SchemaName + "." + tbl.Name;
				W.Observation.Traffic.PercentCompleted = pctCompleted + "%";
				W.NotifyDashboardStateChanged();

				for (var up = 1; up < upLimit; up++)
				{
					for (var down = 1; down < downLimit; down++)
					{
						var options = W.UI.ERSettings.ToGenerationOptions(new List<GraphRelationConstraint>(), GenerationMethod.PlanDrivenExecution);
						options.Traversal.LevelsUp = up;
						options.Traversal.LevelsDown = down;
						options.Retrieval.RootSelectPolicy = TableSelectPolicy.AllColumns;
						options.Retrieval.JoinSelectPolicy = TableSelectPolicy.AllColumns;
						options.Traversal.PreventRootTypeRecursion = true;
						pctCompleted = (int)(((double)(up * down) / (double)(upLimit * downLimit)) * 100);
						W.Observation.Traffic.PercentCompleted = pctCompleted + "%";
						await InvokeAsync(StateHasChanged);

						Parallel.ForEach(tbl.Indexes, new ParallelOptions() { MaxDegreeOfParallelism = 2 }, (index) =>
						{
							string script = $"ALTER INDEX {index.Name} ON {tbl.SchemaName}.{tbl.Name} REBUILD WITH (ONLINE = ON);";
							W.Context.Provider.ExecuteNonQuery(script);
						});

						var gen = new PlanDrivenQueryGenerator();
						var result = gen.Generate(tbl, options);
						var dt = await ConnectionService.Execute(result.GeneratedQuery);
						if (dt == null)
						{
							await Task.Delay(1250);
						}
					}
				}
			});
		}
		catch (Exception ex)
		{
			ExceptionUtility.LogException(ex);
		}
		finally
		{
			W.Observation.Traffic.IsRunning = false;
			await InvokeAsync(StateHasChanged);
		}
	}
	#endregion

	private ChartThemeType _selectedTheme = ChartThemeType.Default;
	private bool isMonacoEditorReady = false;

	private readonly HashSet<string> _expandedSqlHandleHexs = new();
	private TopExpensiveQueriesGrid gridTopExpensiveQueries;
	private ActiveRequestsGrid gridActiveRequests;
	private BlockingGrid gridBlocking;

	private StandaloneCodeEditor queryEditorTopExpensiveQueries;
	private StandaloneCodeEditor queryEditorActiveRequests;
	private StandaloneCodeEditor queryEditorBlocking;

	private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor)
	{
		var br = "\r\n";
		var defaultText = br + string.Join(br, A5C11.GetAsciiArt("JEO3.com", false).Split('\n').Select(v => " " + v.Replace("\r", "").Replace(" ", " ")));
		return new StandaloneEditorConstructionOptions
		{
			AutomaticLayout = true,
			Value = defaultText,
			Minimap = new EditorMinimapOptions { Enabled = false },
			FontSize = 14,
			FontFamily = "Consolas, Cascadia Mono, Cascadia Code, Courier New, monospace",
			Language = "sql",
			Theme = "vs",
			//RenderLineHighlight = "none",
			Guides = new GuidesOptions() { Indentation = false },
			MouseWheelZoom = true,
			CodeLens = false,
			SnippetSuggestions = "none",
			QuickSuggestions = new QuickSuggestionsOptions { Other = "false", Comments = "false", Strings = "false" }
		};
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		_selectedTheme = ChartThemeType.Default;
	}

	private async Task OnThemeChanged()
	{
		StateHasChanged();
	}

	private MonacoThemeData GetTheme()
	{
		return new MonacoThemeData
		{
			Base = "vs-dark",
			Inherit = true,
			Colors = new Dictionary<string, string>
			{
				{ "editor.background", "#000000" },
				{ "editor.foreground", "#00FF00" },
				{ "editorCursor.foreground", "#00FF00" },
				{ "editor.lineHighlightBackground", "#000000" }
			},
			Rules = new List<MonacoTokenRule>
			{
				new MonacoTokenRule { Token = "", Foreground = "00FF00" }
			}
		};
	}

	private async Task ApplyAs400ThemeTopExpensive()
	{
		var as400Theme = GetTheme();

		// Define the theme payload in JS and force the switch
		await JS.InvokeVoidAsync("monacoInterop.defineAndSetTheme", "as400", as400Theme);
		await queryEditorTopExpensiveQueries.SetPosition(new Position() { LineNumber = 1, Column = 0 }, "");
		await queryEditorTopExpensiveQueries.Focus();
	}

	private async Task ApplyAs400ThemeBlocking()
	{
		var as400Theme = GetTheme();

		// Define the theme payload in JS and force the switch
		await JS.InvokeVoidAsync("monacoInterop.defineAndSetTheme", "as400", as400Theme);
		await queryEditorBlocking.SetPosition(new Position() { LineNumber = 1, Column = 0 }, "");
		await queryEditorBlocking.Focus();
	}

	private async Task ApplyAs400ThemeActiveRequests()
	{
		var as400Theme = GetTheme();

		// Define the theme payload in JS and force the switch
		await JS.InvokeVoidAsync("monacoInterop.defineAndSetTheme", "as400", as400Theme);
		await queryEditorActiveRequests.SetPosition(new Position() { LineNumber = 1, Column = 0 }, "");
		await queryEditorActiveRequests.Focus();
	}

	private void OnEditorContentChangedTopExpensiveQueries() { }
	private void OnEditorContentChangedActiveRequests() { }
	private void OnEditorContentChangedBlocking() { }

	private async Task OnEditorInitializedTopExpensiveQueries()
	{
		isMonacoEditorReady = true;
		await ApplyAs400ThemeTopExpensive();
		await InvokeAsync(StateHasChanged);
	}

	private async Task OnEditorInitializedActiveRequests()
	{
		isMonacoEditorReady = true;
		await ApplyAs400ThemeActiveRequests();
		await InvokeAsync(StateHasChanged);
	}

	private async Task OnEditorInitializedBlocking()
	{
		isMonacoEditorReady = true;
		await ApplyAs400ThemeBlocking();
		await InvokeAsync(StateHasChanged);
	}

	private async Task SelectedQueryChanged(ITopExpensiveQueryRow qry)
	{
		if (isMonacoEditorReady == false || queryEditorTopExpensiveQueries == null) { return; }
		await queryEditorTopExpensiveQueries.SetValue(qry?.QueryText ?? string.Empty);
		await InvokeAsync(StateHasChanged);
	}

	private async Task SelectedQueryPlanChanged(ITopExpensiveQueryRow qry)
	{
		if (isMonacoEditorReady == false || queryEditorTopExpensiveQueries == null) { return; }

		if (qry != null && qry.PlanHandleHex != null && qry.StatementStartOffset != null && qry.StatementEndOffset != null)
		{
			var x = await GetPlan(qry.PlanHandleHex, qry.StatementStartOffset, qry.StatementEndOffset);

			if (x != null)
			{
				await ShowExecutionPlanDialog(x);
			}
		}
	}

	private void OnTopExpensiveQueryRowExpand(ITopExpensiveQueryRow blocker)
	{
		_expandedSqlHandleHexs.Add(blocker.SqlHandleHex);
	}

	private void OnTopExpensiveQueryRowCollapse(ITopExpensiveQueryRow blocker)
	{
		_expandedSqlHandleHexs.Remove(blocker.SqlHandleHex);
	}

	private async Task SelectedActiveRequestsChanged(IActiveRequestRow qry)
	{
		if (isMonacoEditorReady == false || queryEditorActiveRequests == null) { return; }
		await queryEditorActiveRequests.SetValue(qry?.StatementText ?? string.Empty);
	}

	private async Task SelectedBlockingSessionChanged(IBlockingRow qry)
	{
		if (isMonacoEditorReady == false || queryEditorBlocking == null) { return; }

		await queryEditorBlocking.SetValue(qry?.QueryText ?? string.Empty);

		if (qry != null && qry.PlanHandle != null && qry.StatementStartOffset != null && qry.StatementEndOffset != null)
		{
			var x = await GetPlan(qry.PlanHandle, qry.StatementStartOffset, qry.StatementEndOffset);

			if (x != null)
			{
				await ShowExecutionPlanDialog(x);
			}
		}
	}

	private async Task<ExecutionPlanRow?> GetPlan(string handle, int? start, int? end)
	{
		var x = await W.Context.Provider.GetInstances<ExecutionPlanRow>($@"
				SELECT 
					qp.query_plan AS FullBatchPlanXml,
					CAST(tp.query_plan AS XML) AS SpecificStatementPlanXml
				FROM (
					SELECT
						CONVERT(VARBINARY(64), '{handle}', 1) AS PlanHandle, 
						CAST({start} AS INT) AS StatementStartOffset,
						CAST({end} AS INT) AS StatementEndOffset
				) b
				CROSS APPLY sys.dm_exec_query_plan(b.PlanHandle) qp
				CROSS APPLY sys.dm_exec_text_query_plan(b.PlanHandle, b.StatementStartOffset, b.StatementEndOffset) tp;
			");

		return x?.FirstOrDefault();
	}

	private async Task RestoreExpandedTopExpensiveQueryRowsAsync()
	{
	}

	
	private async Task ShowExecutionPlanDialog(ExecutionPlanRow row)
	{
		await DialogService.OpenAsync("Query Execution Plan Diagnostics", ds =>
			@<div class="modal-plan-override">
				<ExecutionPlanDisplay RawPlanXml="@row.SpecificStatementPlanXml" />
			</div>,
		new DialogOptions()
		{
			CloseDialogOnOverlayClick = true,
			ShowClose = true,
			Width = "1600px",
			Height = "800px",
			Style = "border-radius: 10px; overflow: hidden; background-color: #0f172a;"
		});
	}
}