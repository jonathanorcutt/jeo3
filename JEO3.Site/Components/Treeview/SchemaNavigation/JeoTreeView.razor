@using JEO3.Schema

@namespace JEO3.Site.Components.Treeview

<div class="jeo-tree">
    @foreach (var item in Items)
    {
        <JeoTreeNode Item="item"
                     SelectedItem="SelectedItem"
                     OnClick="NodeClicked" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<IObject> Items { get; set; } = [];

    [Parameter]
    public EventCallback<IObject> OnClick { get; set; }

    [Parameter]
    public IObject? SelectedItem { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (SelectedItem != null)
            {
                await OnClick.InvokeAsync(SelectedItem);
            }
        }
    }

    private async Task NodeClicked(IObject item)
    {
        SelectedItem = item;

        await OnClick.InvokeAsync(item);
    }
}