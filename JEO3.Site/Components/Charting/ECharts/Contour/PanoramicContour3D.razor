@inherits EChartBase
@namespace JEO3.Site.Components.Charting
@typeparam TRow

<div id="@_containerId" class="schema-contour-3d" style="width: @(Width); height: @(Height); position:absolute;"></div>

@code {
    [Parameter] public IEnumerable<TRow> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Columns { get; set; } = [];
    [Parameter] public Func<TRow, string> RowLabelSelector { get; set; } = _ => string.Empty;
    [Parameter] public Func<TRow, string, double> CellSelector { get; set; } = (_, _) => 0;

    [Parameter] public string Title { get; set; } = "Schema Heat Map";
    [Parameter] public string XAxisTitle { get; set; } = "Metric";
    [Parameter] public string YAxisTitle { get; set; } = "Table";
    [Parameter] public string IntensityLabel { get; set; } = "Complexity";

    protected override string? ContainerId => _containerId;
    private readonly string _containerId = $"chart-contour-3d-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private bool _jsAvailable = false;
    protected override string JavascriptFilePath { get; set; } = "./js/echarts/charts3d.js";

    public PanoramicContour3D() { Height = "100%"; Width = "100vw"; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {        
        // Registers the container with the shared ResizeObserver.
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender || IsDisposed)
            return;

        try
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", JavascriptFilePath);

            _jsAvailable = true;
            await Build3DChartAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"PanoramicContour3D initialization failed: {ex}");
        }
    }

    private async Task Build3DChartAsync()
    {
        if (IsDisposed || !_jsAvailable || _module == null) return;

        var rowsList = Rows?.ToList() ?? [];
        if (rowsList.Count == 0 || Columns.Count == 0 || _module == null) return;

        var chartData = new List<double[]>();
        for (var y = 0; y < rowsList.Count; y++)
        {
            var row = rowsList[y];
            for (var x = 0; x < Columns.Count; x++)
            {
                var intensity = Math.Clamp(CellSelector(row, Columns[x]), 0.0, 1.0);
                chartData.Add(new double[] { x, y, intensity });
            }
        }

        var xAxisCategories = Columns.Select(c => c.ToString()).ToArray();
        var yAxisCategories = rowsList.Select(r => RowLabelSelector(r)).ToArray();

        try
        {
            // Execute out of the isolated module footprint instead of the dirty global window thread
            await _module.InvokeVoidAsync(
                "renderPanoramic3DChart",
                _containerId,
                Title,
                XAxisTitle,
                YAxisTitle,
                IntensityLabel,
                xAxisCategories,
                yAxisCategories,
                chartData
            );
        }
        catch
        {
            // Fail-safe block
        }
    }

    protected override async ValueTask OnDisposeAsync()
    {
        if (_module == null)
            return;

        // try { await _module.InvokeVoidAsync("disposeRelations3D", _containerId); }
        // catch { /* JS runtime can already be gone during circuit shutdown. */ }

        try { await _module.DisposeAsync(); }
        catch { /* Ignore module disposal during shutdown. */ }

        _module = null;
    }
}