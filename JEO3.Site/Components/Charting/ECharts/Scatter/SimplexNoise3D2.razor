@inherits EChartBase
@namespace JEO3.Site.Components.Charting
@typeparam TRow

<div id="@_containerId"
     class="schema-entity-heatmap-3d"
     style="width: @(Width); height: @(Height); position:absolute;">
</div>

@code {
    [Parameter] public IEnumerable<TRow> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Columns { get; set; } = [];
    [Parameter] public Func<TRow, string> RowLabelSelector { get; set; } = _ => string.Empty;
    [Parameter] public Func<TRow, string, double> CellSelector { get; set; } = (_, _) => 0;

    [Parameter] public string Title { get; set; } = "Schema Entity Map";
    [Parameter] public string XAxisTitle { get; set; } = "Entity Type";
    [Parameter] public string YAxisTitle { get; set; } = "Table";
    [Parameter] public string IntensityLabel { get; set; } = "Count";

    private readonly string _containerId = $"chart-entity-heatmap-3d-{Guid.NewGuid():N}";

    protected override string? ContainerId => _containerId;
    protected override string JavascriptFilePath { get; set; } = "./js/echarts/charts3d.js";

    private IJSObjectReference? _module;
    private bool _jsAvailable;

    public SimplexNoise3D2()
    {
        Height = "100%";
        Width = "100%";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender || IsDisposed)
            return;

        try
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", JavascriptFilePath);

            if (IsDisposed)
                return;

            _jsAvailable = true;
            await Build3DChartAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"PanoramicEntityHeatmap3D initialization failed: {ex}");
        }
    }

    private async Task Build3DChartAsync()
    {
        if (IsDisposed || !_jsAvailable || _module == null)
            return;

        var rowsList = Rows?.ToList() ?? [];
        if (rowsList.Count == 0 || Columns.Count == 0)
            return;

        var chartData = new List<double[]>();

        for (var y = 0; y < rowsList.Count; y++)
        {
            var row = rowsList[y];

            for (var x = 0; x < Columns.Count; x++)
            {
                var count = Math.Max(0, CellSelector(row, Columns[x]));
                chartData.Add([x, y, count]);
            }
        }

        var xAxisCategories = Columns.ToArray();
        var yAxisCategories = rowsList.Select(RowLabelSelector).ToArray();

        try
        {
            await _module.InvokeVoidAsync(
                "renderPanoramicEntityHeatmap3D",
                _containerId,
                Title,
                XAxisTitle,
                YAxisTitle,
                IntensityLabel,
                xAxisCategories,
                yAxisCategories,
                chartData);
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"Entity heatmap JS error: {ex.Message}");
        }
    }

    protected override async ValueTask OnDisposeAsync()
    {
        if (_module == null)
            return;

        try
        {
            await _module.InvokeVoidAsync("disposePanoramicEntityHeatmap3D", _containerId);
        }
        catch
        {
            // JS runtime may already be unavailable during circuit shutdown.
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch
        {
            // Ignore module disposal during shutdown.
        }

        _module = null;
    }
}