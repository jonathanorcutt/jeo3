@namespace JEO3.Site.Components

<div class="playground-warning-overlay">
    <div class="hardware-diagnostic-card">
        <!-- Technical Cyberpunk Header Glow Line -->
        <div class="tech-header-accent"></div>

        <div class="card-body">
            <!-- Animated Glitch/Pulse Warning Icon -->
            <div class="hardware-alert-icon">
                <svg xmlns="http://w3.org" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>

            <h3 class="tech-title">SYSTEM HARDWARE NOTICE</h3>
            <div class="status-subtext">STATUS: GPU INSTABILITY RISK DETECTED</div>

            <p class="tech-description">
                The tab items below can be <span class="highlight-text">GPU intensive/costly</span>. If you experience any performance related issues viewing these tabs, try refreshing the page and maybe not clicking on them, as they can impact page performance depending on your hardware.
            </p>

            <!-- Technical Data / UI Fluff to sell the 'serious tool' look -->
            <div class="hardware-footer">
                <span class="pulse-dot"></span>
                <span>MONITORING ACTIVE // HARDWARE DEPENDENT RENDER</span>
            </div>
        </div>
    </div>
</div>


