@using System.Data
@using JEO3.Charts
@using JEO3.Contracts
@using JEO3.Extensions
@using JEO3.Monitor
@inherits MonitorBase
@namespace JEO3.Monitor.ECharts

<div class="monitor-panel">
	@if (LabelText != string.Empty)
	{
		<div class="monitor-panel-title">
			<label class="dashboard-monitor-label">
				<img src="../img/vs_icons/StoredProcedurefromCLRWarning_16x.png" width="18" height="18" class="fa-mr-7" />
				@LabelText
			</label>

			<span class="monitor-section-badge">
				@Queries.Count
			</span>
		</div>
	}

	<div class="dashboard-pane-container" style="height:@(Height); width:@(Width)">
		<div class="dashboard-pane-body-container-scroll">
			<ProgressBarGrid DataTable="@queriesTable" PrimaryKeyColumn="PrimaryKeyColumn"
							 OnRowClick="@(async ((object? a, string? b) row) => {  await HandleTableGridDrillDown((row.a, row.b)); })"
							 AllowVirtualization="true" />
			@* <RadzenDataGrid Data="@Queries"
							TItem="ITopExpensiveQueryRow"
							AllowSorting="true"
							AllowFiltering="false"
							AllowColumnResize="true"
							AllowColumnReorder="true"
							Density="Density.Compact"
							AllowAlternatingRows="true"
							AllowVirtualization="true"
							RowSelect="@(async (t) => { await OnSelectionChanged.InvokeAsync(t); })"
							Style="width: 100%;">

				<Columns>

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="@nameof(ITopExpensiveQueryRow.DatabaseName)"
										  Title="Database"
										  Width="100px" />

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="QueryText"
										  Title="Query Text"
										  Width="450px" />

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="@nameof(ITopExpensiveQueryRow.AvgElapsedMs)"
										  Title="Avg Elapsed (ms)"
										  TextAlign="TextAlign.Right"
										  Width="70px"
										  FormatString="{0:N2}" />

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="@nameof(ITopExpensiveQueryRow.ExecutionCount)"
										  Title="Executions"
										  TextAlign="TextAlign.Right"
										  Width="70px"
										  FormatString="{0:N0}" />

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="@nameof(ITopExpensiveQueryRow.QueryImpact)"
										  Title="Impact"
										  TextAlign="TextAlign.Right"
										  Width="100px"
										  FormatString="{0:N0}" />

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="@nameof(ITopExpensiveQueryRow.AvgCpuMs)"
										  Title="Avg CPU (ms)"
										  TextAlign="TextAlign.Right"
										  Width="70px"
										  FormatString="{0:N2}" />

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="@nameof(ITopExpensiveQueryRow.MaxCpuMs)"
										  Title="Max CPU (ms)"
										  TextAlign="TextAlign.Right"
										  Width="70px"
										  FormatString="{0:N2}" />

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="@nameof(ITopExpensiveQueryRow.AvgIo)"
										  Title="Avg I/O"
										  TextAlign="TextAlign.Right"
										  Width="70px"
										  FormatString="{0:N0}" />

					<RadzenDataGridColumn TItem="ITopExpensiveQueryRow"
										  Property="@nameof(ITopExpensiveQueryRow.LastExecutionTime)"
										  Title="Last Executed"
										  Width="100px"
										  FormatString="{0:MM/dd HH:mm:ss}" />
				</Columns>
			</RadzenDataGrid> *@
		</div>
	</div>
</div>

@code {


	[Parameter] public EventCallback<ITopExpensiveQueryRow> OnSelectionChanged { get; set; }
	[Parameter] public EventCallback<ITopExpensiveQueryRow> OnDataChanged { get; set; }
	[Parameter] public EventCallback<(object? Id, string? Name)> OnRowClick { get; set; }
	private IReadOnlyList<ITopExpensiveQueryRow> Queries { get; set; } = Array.Empty<ITopExpensiveQueryRow>();
	private ITopExpensiveQueryRow selectedQueryRow { get; set; }
	private DataTable queriesTable;
	private int currentQueryRetentionCounter = 0;

	protected override async Task RenderInitialAsync(IMonitorSnapshot initial)
	{
		if (initial.TopExpensiveQueries != null)
		{
			Queries = initial.TopExpensiveQueries.OrderByDescending(r => r.AvgElapsedMs).ToList();

			await PopulateTable();

			selectedQueryRow = Queries.Count > 0 ? Queries.First() : selectedQueryRow;
			await OnDataChanged.InvokeAsync(Queries.FirstOrDefault());

			_ = InvokeAsync(StateHasChanged);
		}
	}

	protected override async Task AppendDeltasAsync(IMonitorDeltaResponse delta)
	{
		// The API only returns this cache when it updates, so don't wipe it out if it's null
		if (delta.TopExpensiveQueries != null && delta.TopExpensiveQueries.Count > 0)
		{
			Queries = delta.TopExpensiveQueries.OrderByDescending(r => r.AvgElapsedMs).ToList();

			await PopulateTable();

			if (selectedQueryRow == null || (selectedQueryRow != null && currentQueryRetentionCounter + 1 >= 1))
			{
				currentQueryRetentionCounter = 0;
				selectedQueryRow = Queries.Count > 0 ? Queries.First() : selectedQueryRow;
				await OnDataChanged.InvokeAsync(Queries.FirstOrDefault());
			}
			else if (selectedQueryRow != null)
			{
				currentQueryRetentionCounter++;
			}
			_ = InvokeAsync(StateHasChanged);
		}
	}

	private async Task PopulateTable()
	{
		const int substrLength = 50;
		queriesTable = Queries.Select((v, i) => new
		{
			PrimaryKeyColumn = v.PlanHandleHex,
			Name = v.PlanHandleHex,
			LastExecution = v.LastExecutionTime,
			Database = v.DatabaseName,
			Query = v.QueryText.Length > substrLength ? v.QueryText.Substring(0, substrLength) : v.QueryText,
			AvgElapsedMs = Math.Round(v.AvgElapsedMs, 2),
			MaxElapsedMs = Math.Round(v.MaxElapsedMs, 2),
			TotalElapsedMs = Math.Round(v.TotalElapsedMs, 2),
			v.ExecutionCount,
			Impact = Math.Round(v.QueryImpact, 2),
			AvgCpuMs = Math.Round(v.AvgCpuMs, 2),
			// v.MaxCpuMs,
			TotalCpuMs = Math.Round(v.TotalCpuMs, 2),
			// v.MaxLogicalWrites,
			AvgLogWrites = Math.Round(v.AvgLogicalWrites, 0),
			TotalLogWrites = Math.Round((decimal)v.TotalLogicalWrites, 0),
			AvgLogReads = Math.Round(v.AvgLogicalReads, 0),
			// v.MaxLogicalReads,
			TotalLogReads = Math.Round((decimal)v.TotalLogicalReads, 0),
			// v.AvgIo,
			// v.MaxIo,
			// v.TotalIo,
			// v.PlanHandleHex,
			// v.SqlHandleHex,
			// v.Timestamp,
		}).OrderByDescending(v => v.AvgElapsedMs).ToDataTable();
	}

	private async Task HandleTableGridDrillDown((object? id, string? Name) args)
	{
		if (args.Name == null || typeof(string).IsAssignableFrom(args.Name.GetType()) == false) { return; }
		var obj = Queries.FirstOrDefault(v => v.PlanHandleHex.ToString() == args.Name.ToString());

		if (obj != null)
		{
			await OnSelectionChanged.InvokeAsync((ITopExpensiveQueryRow)obj);
		}
	}
}